# --- Server ---
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend.vercel.app

# --- Database (MongoDB Atlas free M0 tier) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lifeos-ai

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_CALLBACK_URL=https://your-backend.onrender.com/api/auth/github/callback

# --- AI ---
# Get a key at https://console.anthropic.com (pay-as-you-go, not free, but very cheap for personal use)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
